{
  // Copy as config/preferences.jsonc in this Eurysx checkout.
  "schemaVersion": 2,
  "agents": {
    "claude-code": {
      "billingMode": "unknown"
    },
    "codex": {
      "providers": {
        "openai": { "billingMode": "subscription" },
        "amazon-bedrock": {
          "billingMode": "metered",
          "pricing": { "source": "amazon-bedrock", "otherSources": ["models-dev", "pi-models-store"] }
        },
        "litellm": { "billingMode": "local" }
      }
    },
    "opencode": {
      "billingMode": "unknown"
    },
    "pi": {
      "billingMode": "unknown"
    }
  }
}
