{
  // Copy as config/preferences.jsonc in this Eurysx checkout.
  "schemaVersion": 3,
  "agents": {
    "claude-code": {
      "billingMode": "unknown",
      // Optional: {"usd": 100, "period": "month"}
    },
    "codex": {
      "providers": {
        "openai": { "billingMode": "subscription" },
        "amazon-bedrock": {
          "billingMode": "metered",
          "pricing": { "source": "amazon-bedrock", "otherSources": ["models-dev", "pi-models-store"] }
        },
        "litellm": {
          "billingMode": "unknown",
          // Set true only with an exact configured pricing source; this is an
          // API-equivalent estimate, not billable or budget spend.
          "pricing": { "estimateApiEquivalent": false },
          "modelIdRules": [{ "prefix": "local.", "billingMode": "local" }]
        }
      }
    },
    "opencode": {
      "billingMode": "unknown"
    },
    "pi": {
      "billingMode": "unknown"
    }
  }
}
