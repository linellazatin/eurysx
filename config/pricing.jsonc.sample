{
  // All sources are disabled by default. Copy this as
  // config/pricing.jsonc in this Eurysx checkout; see docs/manual.md.
  // Enable only sources you trust.
  "schemaVersion": 2,
  "sources": {
    "amazon-bedrock": {
      "enabled": false,
      "profile": "default",
      "region": "us-east-1",
      "refreshDays": 7
    },
    "pi-models-store": {
      "enabled": false,
      "refreshDays": 15
    },
    "models-dev": {
      "enabled": false,
      "url": "https://models.dev/api.json",
      "refreshDays": 7
    },
    "litellm-proxy": {
      "enabled": false,
      "path": "/absolute/path/to/litellm-price-metadata.yaml",
      "provider": "my-litellm-proxy",
      "refreshDays": 7
    }
  },
  "aliases": {},
  "overrides": {}
}
