{
  // Remote sources are disabled by default. Copy this as
  // config/pricing.jsonc in this Eurysx checkout; see README.md.
  // Enable only sources you trust.
  "sources": {
    "aws-bedrock": {
      "enabled": false,
      "priority": 1,
      "profile": "your-aws-pf",
      "region": "us-east-1",
      "refreshDays": 7
    },
    "pi-models-store": {
      "enabled": false,
      "priority": 2,
      "refreshDays": 15
    },
    "models-dev": {
      "enabled": false,
      "priority": 3,
      "url": "https://models.dev/api.json",
      "refreshDays": 7
    }
  },
  "overrides": {}
}
